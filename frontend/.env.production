VITE_GOOGLE_CLIENT_ID=509222419867-jimqvpsv69itti290skus846l13143kl.apps.googleusercontent.com

# Catalog is read straight from Supabase (RLS: anon can SELECT active products only). Public values.
# Set VITE_PRODUCTS_SOURCE=api to read through the FastAPI backend instead.
VITE_SUPABASE_URL=https://onyyiitqgbmauxqorcmp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_M-2OQHMwNpjqfyFOko4RYA_kiy5X8sE
VITE_PRODUCTS_SOURCE=supabase
# Email/password and Google sign-in go through Supabase Auth first and fall back to the API.
# Set VITE_AUTH_SOURCE=api to use only the API login.
VITE_AUTH_SOURCE=supabase
