# ---- Database (Neon pooler URL; rotate the password if it was ever shared) ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# ---- Auth ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---- URLs / CORS (comma-separated origins, no wildcard) ----
CORS_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ---- Payments (UddoktaPay) ----
PAYMENT_GATEWAY_BASE_URL=https://sandbox.uddoktapay.com
PAYMENT_GATEWAY_API_KEY=
# Used only when no gateway API key is set (HMAC fallback mode)
PAYMENT_WEBHOOK_SECRET=

# ---- Media storage (Cloudflare R2 / S3) ----
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
PUBLIC_CDN_URL=https://cdn.example.com

# ---- Facebook login ----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- SMS (BD gateway) ----
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
